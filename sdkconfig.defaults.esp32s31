CONFIG_SR_WN_WN9_HIESP=y
CONFIG_VIDEO_PROCESSOR_ENABLE=y

# This chatbot target does not use a Bluetooth device today, so keep the A2DP HAL and Classic
# speaker stack off. Re-enable the block below when the example actually needs BT audio.

# CONFIG_BROOKESIA_HAL_ADAPTOR_ENABLE_BT_DEVICE=y

# Bluetooth speaker (Classic BR/EDR + A2DP Sink + AVRCP)
# NOTE: on this board WiFi runs on-chip and coexists with BT (the boot log shows BTDM + coex
# firmware + 11ax coex), so internal RAM is very tight (~262 KB heap). The settings below keep the
# classic-BT footprint as small as possible so it can co-reside with the AI agent (AFE/OPUS/WiFi).
#
# CONFIG_BT_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED=y
# CONFIG_BT_NIMBLE_ENABLED is not set
# CONFIG_BT_CONTROLLER_ENABLED=y
# CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
# CONFIG_BT_CTRL_SLEEP_ENABLE is not set
# NOTE: MAX_SYNC_CONN=0 was tried to save ~2 KB of SYNC controller buffers, but it causes A2DP music
# playback to stutter / produce noise on this controller (even though A2DP only uses ACL). Keep the
# default (1 SYNC connection) for clean Bluetooth audio.
# CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=1
# One A2DP sink connection is sufficient; reduce ACL buffers to minimum.
# CONFIG_BT_CTRL_BR_EDR_MAX_ACL_CONN=1
# CONFIG_BT_CTRL_BR_EDR_ACLU_TX_BUF_NB=3
# CONFIG_BT_CTRL_BR_EDR_ACLU_RX_BUF_NB=4
# CONFIG_BT_CLASSIC_ENABLED=y
# CONFIG_BT_A2DP_ENABLE=y
# CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=y
# CONFIG_BT_AVRCP_ENABLED=y
# Cover-art download is not needed for a speaker; disabling it frees Bluedroid buffers.
# CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED is not set
# CONFIG_BT_BLE_ENABLED is not set
# CONFIG_ESP_BT_AUDIO_GMF_IO_SUPPORT=y

## WiFi
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUFFER=y
CONFIG_ESP_WIFI_TX_BA_WIN=16
CONFIG_ESP_WIFI_RX_BA_WIN=8
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_LWIP_TCP_RECVMBOX_SIZE=10
CONFIG_LWIP_TCP_ACCEPTMBOX_SIZE=8
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=6
