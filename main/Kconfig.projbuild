menu "Example Configuration"
    menuconfig EXAMPLE_AGENTS_ENABLE_COZE
        bool "Enable Coze agent"
        select BROOKESIA_AGENT_COZE_ENABLE_AUTO_REGISTER
        default n

    if EXAMPLE_AGENTS_ENABLE_COZE
        config EXAMPLE_AGENTS_COZE_APP_ID
            string "App ID"
            default "110049xxxxxxx"

        config EXAMPLE_AGENTS_COZE_PUBLIC_KEY
            string "Public key"
            default "lsKjtB67xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

        config EXAMPLE_AGENTS_COZE_PRIVATE_KEY_FILE_PATH
            string "Private key"
            default "./private_key.pem"

        config EXAMPLE_AGENTS_COZE_CUSTOM_CONSUMER
            string "Custom consumer (Optional)"
            default ""

        menuconfig EXAMPLE_AGENTS_COZE_BOT1_ENABLE
            bool "Bot 1"
            default y

        if EXAMPLE_AGENTS_COZE_BOT1_ENABLE
            config EXAMPLE_AGENTS_COZE_BOT1_NAME
                string "Bot name"
                default "Lin Jia Nv Hai"

            config EXAMPLE_AGENTS_COZE_BOT1_ID
                string "Bot ID"
                default "7516538xxxxxxxxxxxx"

            config EXAMPLE_AGENTS_COZE_BOT1_DESCRIPTION
                string "Bot description"
                default "A warm-voiced female AI character who listens to the user's thoughts and offers comforting responses."

            config EXAMPLE_AGENTS_COZE_BOT1_VOICE_ID
                string "Bot voice ID"
                default "7426720361733144585"
        endif

        menuconfig EXAMPLE_AGENTS_COZE_BOT2_ENABLE
            bool "Bot 2"
            default n

        if EXAMPLE_AGENTS_COZE_BOT2_ENABLE
            config EXAMPLE_AGENTS_COZE_BOT2_NAME
                string "Bot name"
                default "Wan Qu Da Shu"

            config EXAMPLE_AGENTS_COZE_BOT2_ID
                string "Bot ID"
                default "7516538xxxxxxxxxxxx"

            config EXAMPLE_AGENTS_COZE_BOT2_DESCRIPTION
                string "Bot description"
                default "A male AI character with a regional accent. He responds quickly and concisely, but does not perform actions on behalf of the user."

            config EXAMPLE_AGENTS_COZE_BOT2_VOICE_ID
                string "Bot voice ID"
                default "7426720361732915209"
        endif
    endif

    menuconfig EXAMPLE_AGENTS_ENABLE_OPENAI
        bool "Enable OpenAI agent"
        select BROOKESIA_AGENT_OPENAI_ENABLE_AUTO_REGISTER
        default n

    if EXAMPLE_AGENTS_ENABLE_OPENAI
        config EXAMPLE_AGENTS_OPENAI_API_KEY
            string "API key"
            default "sk-proj-xxx"

        config EXAMPLE_AGENTS_OPENAI_MODEL
            string "Model"
            default "gpt-realtime-2"

        config EXAMPLE_AGENTS_OPENAI_VOICE
            string "Voice"
            default "alloy"
    endif

    menuconfig EXAMPLE_AGENTS_ENABLE_XIAOZHI
        bool "Enable Xiaozhi agent"
        select BROOKESIA_AGENT_XIAOZHI_ENABLE_AUTO_REGISTER
        default y

    config EXAMPLE_UI_AUTO_HOME_TIMEOUT_MS
        int "UI auto-Home timeout (ms)"
        range 1000 3600000
        default 30000
        help
            Time without physical LCD input before navigation screens may
            return to Home. Clock and critical flows are not redirected.

    config EXAMPLE_IMU_LIFT_TILT_DEGREES
        int "Lift-to-wake tilt threshold (degrees)"
        range 10 60
        default 25

    config EXAMPLE_IMU_LIFT_STABLE_MS
        int "Lift-to-wake stable pose duration (ms)"
        range 100 1000
        default 200

    config EXAMPLE_IMU_LIFT_COOLDOWN_MS
        int "Lift-to-wake cooldown (ms)"
        range 1000 10000
        default 3000

    config EXAMPLE_PWR_DIM_TIMEOUT_MS
        int "Power dim timeout (ms)"
        range 1000 3600000
        default 60000
        help
            Time without physical LCD input before the power manager may dim
            the display. If the agent is active, dimming waits until it sleeps.

    config EXAMPLE_PWR_DIM_BRIGHTNESS_PERCENT
        int "Power dim brightness (percent)"
        range 1 100
        default 10

    config EXAMPLE_PWR_HW_SLEEP_TIMEOUT_MS
        int "Hardware sleep timeout after dimming (ms)"
        range 1000 86400000
        default 300000
        help
            Time measured from successful entry into the Dimmed state.
            Registered display participants coordinate render pause and panel sleep.

    config EXAMPLE_PWR_PREPARE_TIMEOUT_MS
        int "Suspend prepare and commit acknowledgement timeout (ms)"
        range 100 60000
        default 2000
        help
            Deadline for each prepare or commit stage of registered participants.
            Does not replace panel-specific command timing.

    config EXAMPLE_PWR_RESUME_TIMEOUT_MS
        int "Suspend cancellation and resume timeout (ms)"
        range 100 60000
        default 2000

    config EXAMPLE_PWR_SUSPEND_RETRY_MS
        int "Suspend retry backoff (ms)"
        range 100 60000
        default 5000

    config EXAMPLE_PWR_MEMORY_DIAGNOSTICS
        bool "Log Pwr heap and worker-stack diagnostics"
        default n
        help
            Print SRAM/PSRAM and worker stack measurements at power state changes,
            plus heap measurements around Pwr service startup. The shared memory
            profiler and power warning/error logs remain enabled independently.

endmenu
